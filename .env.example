# Application
APP_NAME=AI LinkedIn Content Agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
BACKEND_URL=http://backend:8000
FRONTEND_URL=http://localhost:8501
CORS_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO

# Authentication and encryption
# Generate each value locally, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# PostgreSQL: local Docker defaults. Replace DATABASE_URL for Supabase or Neon.
POSTGRES_DB=linkedin_agent
POSTGRES_USER=linkedin_agent
POSTGRES_PASSWORD=linkedin_agent_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://linkedin_agent:linkedin_agent_local_password@db:5432/linkedin_agent

# Storage: local is the default; Supabase Storage is optional.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=linkedin-agent

# LLM providers: configure at least one before running AI workflows.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=AI LinkedIn Content Agent
OPENROUTER_SITE_URL=http://localhost:8501

# Initial model defaults; all assignments become database-managed in phase 3.
DEFAULT_WRITER_MODEL=
DEFAULT_REVIEWER_MODEL=
DEFAULT_JUDGE_MODEL=
DEFAULT_TRANSLATION_MODEL=

# Image generation: Pollinations requires no key; Hugging Face is the fallback.
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_MODEL=flux
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# LinkedIn OAuth and publishing
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/linkedin/oauth/callback
LINKEDIN_SCOPES=openid,profile,w_member_social

# Adzuna free developer API. Manual job entry remains available without these.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Scheduling
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
